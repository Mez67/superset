# Copy to .env and replace every CHANGE_ME before the first start.
# install.sh / install.ps1 refuse to start while a CHANGE_ME is left.

# Images in images.tar (filled in by build-bundle.ps1)
SUPERSET_IMAGE=danehnama/superset:latest
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:7
# Port on the server (Superset listens on 8088 inside its container)
SUPERSET_HOST_PORT=8088

# Secrets: long random strings, e.g. `openssl rand -base64 42`.
# SUPERSET_SECRET_KEY encrypts stored database passwords: keep a copy, and
# never change it after the first start.
SUPERSET_SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME
# Password of the first "admin" user (change it after the first sign-in)
ADMIN_PASSWORD=CHANGE_ME

# Metadata database (the bundled PostgreSQL container)
DATABASE_DIALECT=postgresql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset
DATABASE_USER=superset
POSTGRES_DB=superset
POSTGRES_USER=superset

REDIS_HOST=redis
REDIS_PORT=6379

# Production mode: no example data, no debug, no live reloading
SUPERSET_ENV=production
DEV_MODE=false
FLASK_DEBUG=false
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_LOG_LEVEL=info
SUPERSET_APP_ROOT=/
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
PYTHONUNBUFFERED=1
