#, python-format
msgid "The parameter %(parameters)s in your query is undefined."
msgid_plural "The following parameters in your query are undefined: %(parameters)s."
msgstr[0] "پارامتر %(parameters)s در کوئری شما تعریف نشده است."
msgstr[1] "پارامترهای زیر در کوئری شما تعریف نشده‌اند: %(parameters)s."

#, python-format
msgid ""
"The partition column cannot be mapped onto itself. %(name)s is both the "
"partition column and the mapped column."
msgstr ""
"ستون پارتیشن نمی‌تواند به خودش نگاشت شود. %(name)s هم ستون پارتیشن و هم "
"ستون نگاشت‌شده است."

msgid "The partition filter mapping was cleared: its column is gone"
msgstr "نگاشت فیلتر پارتیشن پاک شد: ستون آن دیگر وجود ندارد"

msgid "The password could not be reset. Please try again."
msgstr "بازنشانی گذرواژه ممکن نشد. لطفاً دوباره تلاش کنید."

#, python-format
msgid "The password provided for username \"%(username)s\" is incorrect."
msgstr "رمز عبور ارائه شده برای نام کاربری \"%(username)s\" نادرست است."

msgid "The password provided when connecting to a database is not valid."
msgstr "رمز عبوری که هنگام اتصال به پایگاه داده ارائه شده است معتبر نیست."

msgid "The password reset was successful"
msgstr "گذرواژه با موفقیت بازنشانی شد"

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the charts. Please note that the \"Certificate\" section of"
" the database configuration is not present in export files, and should be"
" added manually after the import if it is needed."
msgstr ""
"برای وارد کردن پایگاه‌های داده زیر همراه با نمودارها به گذرواژه آن‌ها "
"نیاز است. توجه کنید که بخش «گواهی» پیکربندی پایگاه داده در فایل‌های خروجی"
" وجود ندارد و در صورت نیاز باید پس از وارد کردن به‌صورت دستی اضافه شود."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the dashboards. Please note that the \"Certificate\" "
"section of the database configuration is not present in export files, and"
" should be added manually after the import if it is needed."
msgstr ""
"برای وارد کردن پایگاه‌های داده زیر همراه با داشبوردها به گذرواژه آن‌ها "
"نیاز است. توجه کنید که بخش «گواهی» پیکربندی پایگاه داده در فایل‌های خروجی"
" وجود ندارد و در صورت نیاز باید پس از وارد کردن به‌صورت دستی اضافه شود."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the datasets. Please note that the \"Certificate\" section "
"of the database configuration is not present in export files, and should "
"be added manually after the import if it is needed."
msgstr ""
"برای وارد کردن پایگاه‌های داده زیر همراه با مجموعه داده‌ها به گذرواژه "
"آن‌ها نیاز است. توجه کنید که بخش «گواهی» پیکربندی پایگاه داده در فایل‌های"
" خروجی وجود ندارد و در صورت نیاز باید پس از وارد کردن به‌صورت دستی اضافه "
"شود."

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the saved queries. Please note that the \"Certificate\" "
"section of the database configuration is not present in export files, and"
" should be added manually after the import if it is needed."
msgstr ""
"برای وارد کردن پایگاه‌های داده زیر همراه با کوئری‌های ذخیره‌شده به "
"گذرواژه آن‌ها نیاز است. توجه کنید که بخش «گواهی» پیکربندی پایگاه داده در "
"فایل‌های خروجی وجود ندارد و در صورت نیاز باید پس از وارد کردن به‌صورت "
"دستی اضافه شود."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: de, sr,
# sr_Latn]
msgid "The passwords for the databases below are needed in order to import them."
msgstr "برای وارد کردن پایگاه‌های داده زیر به گذرواژه آن‌ها نیاز است."

msgid "The pattern of timestamp format. For strings use "
msgstr "الگوی فرمت زمان‌مهر. برای رشته‌ها از استفاده کنید"

msgid ""
"The periodicity over which to pivot time. Each period becomes\n"
"                its own overlaid series, so pick a Time Grain finer than "
"this\n"
"                frequency to see lines (e.g. Day grain with a weekly\n"
"                frequency); with one data point per period each series "
"renders\n"
"                as a single dot. Users can provide \"Pandas\" offset "
"aliases.\n"
"                Click on the info bubble for more details on accepted "
"\"freq\"\n"
"                expressions."
msgstr ""
"دوره تناوبی که زمان بر اساس آن محوری می‌شود. هر دوره\n"
"                به یک سری هم‌پوشان جداگانه تبدیل می‌شود، پس دانه‌بندی "
"زمانی را ریزتر از این\n"
"                تناوب انتخاب کنید تا خطوط دیده شوند (مثلاً دانه‌بندی "
"روزانه با تناوب\n"
"                هفتگی)؛ با یک نقطه داده در هر دوره، هر سری\n"
"                فقط یک نقطه نمایش داده می‌شود. کاربران می‌توانند نام‌های "
"مستعار offset در «Pandas» را وارد کنند.\n"
"                برای جزئیات بیشتر درباره عبارت‌های «freq» قابل قبول\n"
"                روی حباب اطلاعات کلیک کنید."

msgid ""
"The physical column the engine partitions on. Filters on the mapped "
"column are mirrored onto it so the engine can prune partitions."
msgstr ""
"ستون فیزیکی که موتور بر اساس آن پارتیشن‌بندی می‌کند. فیلترهای روی ستون "
"نگاشت‌شده روی آن منعکس می‌شوند تا موتور بتواند پارتیشن‌ها را هرس کند."

msgid "The pixel radius"
msgstr "شعاع پیکسل"

msgid ""
"The pointer to a physical table (or view). Keep in mind that the chart is"
" associated to this Superset logical table, and this logical table points"
" the physical table referenced here."
msgstr ""
"یک اشاره‌گر به یک جدول (یا نمای) فیزیکی. به یاد داشته باشید که نمودار به "
"این جدول منطقی سوپرسیت وابسته است و این جدول منطقی به جدول فیزیکی اشاره "
"شده در اینجا اشاره می‌کند."

msgid "The port is closed."
msgstr "بندر بسته است."

msgid "The port number is invalid."
msgstr "شماره پورت نامعتبر است."

msgid "The preview could not be loaded."
msgstr "پیش‌نمایش بارگذاری نشد."

msgid "The primary metric is used to define the arc segment sizes"
msgstr "معیار اصلی برای تعریف اندازه‌های بخش‌های قوس استفاده می‌شود."

msgid "The provided table was not found in the provided database"
msgstr "جدول ارائه شده در پایگاه داده ارائه شده یافت نشد."

msgid "The provider query will be available after the chart runs."
msgstr "کوئری ارائه‌دهنده پس از اجرای نمودار در دسترس خواهد بود."

msgid "The query associated with the results was deleted."
msgstr "کوئری مرتبط با نتایج حذف شد."

msgid ""
"The query associated with these results could not be found. You need to "
"re-run the original query."
msgstr ""
"کوئری مرتبط با این نتایج پیدا نشد. شما باید کوئری اصلی را دوباره اجرا "
"کنید."

msgid "The query contains one or more malformed template parameters."
msgstr "کوئری شامل یک یا چند پارامتر الگوی نادرست است."

msgid "The query context datasource does not match the chart datasource"
msgstr "منبع داده بافت کوئری با منبع داده نمودار مطابقت ندارد"

#, python-format
msgid ""
"The query context for chart ID %(chart_id)s (referenced by annotation "
"layer '%(layer_name)s') was not found. Please ensure the chart is "
"properly configured and has a valid query context."
msgstr ""
"بافت کوئری برای نمودار با شناسه %(chart_id)s (که لایه حاشیه‌نویسی "
"«%(layer_name)s» به آن اشاره دارد) پیدا نشد. لطفاً مطمئن شوید نمودار "
"به‌درستی پیکربندی شده و بافت کوئری معتبری دارد."

msgid "The query couldn't be loaded"
msgstr "کوئری نتوانست بارگذاری شود"

#, python-format
msgid ""
"The query estimation was killed after %(sqllab_timeout)s seconds. It "
"might be too complex, or the database might be under heavy load."
msgstr ""
"برآورد کوئری پس از %(sqllab_timeout)s ثانیه متوقف شد. ممکن است بیش از حد "
"پیچیده باشد یا پایگاه داده تحت بار سنگینی باشد."

msgid "The query has a syntax error."
msgstr "این سؤال دارای یک خطای نگارشی است."

msgid "The query returned no data"
msgstr "نتیجه جستجو داده‌ای بازنگرداند."

#, python-format
msgid ""
"The query was killed after %(sqllab_timeout)s seconds. It might be too "
"complex, or the database might be under heavy load."
msgstr ""
"این کوئری پس از %(sqllab_timeout)s ثانیه متوقف شد. ممکن است خیلی پیچیده "
"باشد، یا پایگاه داده تحت بار زیادی قرار داشته باشد."

msgid ""
"The radius (in pixels) the algorithm uses to define a cluster. Choose 0 "
"to turn off clustering, but beware that a large number of points (>1000) "
"will cause lag."
msgstr ""
"شعاع (به پیکسل) که الگوریتم برای تعریف یک خوشه استفاده می‌کند. برای "
"غیرفعال کردن خوشه‌بندی، عدد ۰ را انتخاب کنید، اما توجه داشته باشید که "
"تعداد زیادی نقطه (>۱۰۰۰) باعث ایجاد تأخیر خواهد شد."

msgid ""
"The radius of individual points (ones that are not in a cluster). Either "
"a numerical column or `Auto`, which scales the point based on the largest"
" cluster"
msgstr ""
"شعاع نقاط جداگانه (نقاطی که در یک خوشه نیستند). می‌تواند یک ستون عددی یا "
"`خودکار` باشد که نقطه را بر اساس بزرگ‌ترین خوشه مقیاس می‌کند."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ja]
msgid ""
"The radius of point features, in the units specified below. The final "
"rendered size is this value multiplied by Point Radius Scale."
msgstr ""
"شعاع عوارض نقطه‌ای، بر حسب واحد مشخص‌شده در زیر. اندازه نهایی نمایش، این "
"مقدار ضرب در «مقیاس شعاع نقطه» است."

#, python-format
msgid "The remaining %s will be moved to Recently Archived."
msgstr "%s باقی‌مانده به «بایگانی‌شده‌های اخیر» منتقل می‌شوند."

msgid "The report has been created"
msgstr "گزارش ایجاد شده است"

#, python-format
msgid ""
"The report runs as %(username)s, who cannot access its %(kind)s: "
"%(reason)s"
msgstr ""
"گزارش با کاربر %(username)s اجرا می‌شود که به %(kind)s آن دسترسی ندارد: "
"%(reason)s"

msgid "The report will be sent to your email at"
msgstr "گزارش به ایمیل شما در تاریخ ارسال خواهد شد"

msgid ""
"The result of this query must be a value capable of numeric "
"interpretation e.g. 1, 1.0, or \"1\" (compatible with Python's float() "
"function)."
msgstr ""
"نتیجه این کوئری باید مقداری باشد که قابلیت تفسیر عددی داشته باشد، مانند "
"۱، ۱.۰، یا \"۱\" (سازگار با تابع float() در پایتون)."

msgid "The result size exceeds the allowed limit."
msgstr "اندازه نتیجه از حد مجاز بیشتر است."

msgid "The results backend no longer has the data from the query."
msgstr "نتیجه پس‌زمینه دیگر داده‌های مربوط به کوئری را ندارد."

msgid ""
"The results stored in the backend were stored in a different format, and "
"no longer can be deserialized."
msgstr ""
"نتایج ذخیره شده در بخش پشتی به فرمت متفاوتی ذخیره شده‌اند و دیگر نمی‌توان"
" آن‌ها را غیرسریال‌سازی کرد."

msgid "The rich tooltip shows a list of all series for that point in time"
msgstr "ابزارک غنی فهرستی از تمام سری‌ها برای آن نقطه زمانی را نمایش می‌دهد"

msgid "The role has been created successfully."
msgstr "نقش با موفقیت ایجاد شد."

msgid "The role has been duplicated successfully."
msgstr "نقش با موفقیت تکثیر شد."

msgid "The role has been updated successfully."
msgstr "نقش با موفقیت به‌روزرسانی شد."

msgid ""
"The row limit selected for this pane was reached. There may be more "
"matching rows."
msgstr ""
"به محدودیت ردیف انتخاب‌شده برای این پنل رسیدید. ممکن است ردیف‌های منطبق "
"بیشتری وجود داشته باشد."

msgid ""
"The row limit set for the chart was reached. The chart may show partial "
"data."
msgstr ""
"حداکثر تعداد ردیف تعیین شده برای نمودار رسیده است. نمودار ممکن است داده "
"های ناقص را نمایش دهد."

#, python-format
msgid "The sample row limit was reached. This %s may contain more rows."
msgstr "به محدودیت ردیف نمونه رسیدید. این %s ممکن است ردیف‌های بیشتری داشته باشد."

#, python-format
msgid ""
"The schema \"%(schema)s\" does not exist. A valid schema must be used to "
"run this query."
msgstr ""
"اسکیمای \"%(schema)s\" وجود ندارد. برای اجرای این کوئری، باید از یک "
"اسکیمای معتبر استفاده شود."

#, python-format
msgid "The schema \"%(schema_name)s\" does not exist."
msgstr "اسکیمای «%(schema_name)s» وجود ندارد."

#, python-format
msgid ""
"The schema \"%(schema_name)s\" does not exist. A valid schema must be "
"used to run this query."
msgstr ""
"اسکیمای \"%(schema_name)s\" وجود ندارد. برای اجرای این کوئری باید از یک "
"اسکیمای معتبر استفاده شود."

msgid "The schema of the submitted payload is invalid."
msgstr "اسکیمای بارگذاری شده نامعتبر است."

msgid "The schema was deleted or renamed in the database."
msgstr "شمایل در پایگاه داده حذف یا تغییر نام داده شده است."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ca, cs, de,
# es, fr, ja, lv, mi, pl, pt_BR, ro, ru, sk, sl, sr, sr_Latn, tr, uk]
msgid "The screenshot could not be downloaded. Please, try again later."
msgstr "دانلود تصویر صفحه ممکن نشد. لطفاً بعداً دوباره تلاش کنید."

msgid "The screenshot has been downloaded."
msgstr "تصویر صفحه دانلود شد."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ca, cs, de,
# es, fr, ja, lv, mi, pl, pt_BR, ro, ru, sk, sl, sr, sr_Latn, tr, uk]
msgid "The screenshot is being generated. Please, do not leave the page."
msgstr "تصویر صفحه در حال ساخت است. لطفاً صفحه را ترک نکنید."

#, python-format
msgid ""
"The selected %(type)s are linked to %(charts)s and %(dashboards)s. "
"Archiving them will make dependent charts unavailable until they are "
"recovered."
msgstr ""
"%(type)s انتخاب‌شده به %(charts)s و %(dashboards)s پیوند دارند. بایگانی "
"آن‌ها نمودارهای وابسته را تا زمان بازیابی از دسترس خارج می‌کند."

#, python-format
msgid ""
"The selected %(type)s are used by %(charts)s. Archiving them will make "
"dependent charts unavailable until they are recovered."
msgstr ""
"%(type)s انتخاب‌شده توسط %(charts)s استفاده می‌شوند. بایگانی آن‌ها "
"نمودارهای وابسته را تا زمان بازیابی از دسترس خارج می‌کند."

#, python-format
msgid ""
"The selected %s are linked to %s and %s. Deleting them will break those "
"objects."
msgstr "%s انتخاب‌شده به %s و %s پیوند دارند. حذف آن‌ها این موارد را خراب می‌کند."

msgid ""
"The semantic layer could not verify that this query result is complete. "
"Retry the query; if it continues, ask an administrator to check the "
"semantic-layer connection."
msgstr ""
"لایه معنایی نتوانست کامل بودن نتیجه این کوئری را تأیید کند. کوئری را "
"دوباره اجرا کنید؛ اگر ادامه داشت، از مدیر سیستم بخواهید اتصال لایه معنایی"
" را بررسی کند."

msgid ""
"The semantic layer returned only part of this query result. Narrow the "
"time range or selected dimensions, or request a smaller explicit row "
"limit, then retry. Result pagination is not supported yet."
msgstr ""
"لایه معنایی فقط بخشی از نتیجه این کوئری را برگرداند. بازه زمانی یا ابعاد "
"انتخاب‌شده را محدودتر کنید، یا محدودیت ردیف صریح کوچک‌تری درخواست کنید، "
"سپس دوباره تلاش کنید. صفحه‌بندی نتایج هنوز پشتیبانی نمی‌شود."

msgid ""
"The semantic query is invalid. Check its fields and options, then try "
"again."
msgstr ""
"کوئری معنایی نامعتبر است. فیلدها و گزینه‌های آن را بررسی کرده و دوباره "
"تلاش کنید."

msgid "The semantic-layer provider is unavailable."
msgstr "ارائه‌دهنده لایه معنایی در دسترس نیست."

msgid "The service url of the layer"
msgstr "نشانی سرویس لایه"

msgid "The size of each cell in meters"
msgstr "اندازه هر سلول به متر"

msgid "The size of the point icons"
msgstr "اندازه نمادهای نقطه"

msgid "The size of the square cell, in pixels"
msgstr "اندازه سلول مربعی، به پیکسل"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ca, cs, de,
# es, fr, ja, lv, mi, ro, ru, sk, sr, sr_Latn, tr, uk]
msgid "The slope to compute all sizes from. \"LINEAR\" only"
msgstr "شیبی که همه اندازه‌ها بر اساس آن محاسبه می‌شوند. فقط «LINEAR»"

msgid "The submitted payload failed validation."
msgstr "بار ارسال شده در اعتبارسنجی شکست خورد."

msgid "The submitted payload has the incorrect format."
msgstr "بارگزاری شده دارای فرمت نادرست است."

msgid "The submitted payload has the incorrect schema."
msgstr "بارگذاری ارسال شده دارای ساختار نادرست است."

#, python-format
msgid ""
"The table \"%(table)s\" does not exist. A valid table must be used to run"
" this query."
msgstr ""
"جدول \"%(table)s\" وجود ندارد. برای اجرای این کوئری باید از یک جدول معتبر"
" استفاده شود."

#, python-format
msgid "The table \"%(table_name)s\" does not exist."
msgstr "جدول «%(table_name)s» وجود ندارد."

#, python-format
msgid ""
"The table \"%(table_name)s\" does not exist. A valid table must be used "
"to run this query."
msgstr ""
"جدول \"%(table_name)s\" وجود ندارد. برای اجرای این کوئری، باید از یک جدول"
" معتبر استفاده شود."

msgid "The table was deleted or renamed in the database."
msgstr "جدول در پایگاه داده حذف یا تغییر نام داده شده است."

msgid ""
"The time column for the visualization. Note that you can define arbitrary"
" expression that return a DATETIME column in the table. Also note that "
"the filter below is applied against this column or expression"
msgstr ""
"ستون زمان برای تجسم. توجه داشته باشید که می‌توانید عبارت‌های دلخواهی را "
"تعریف کنید که یک ستون DATETIME در جدول بازگردانند. همچنین توجه داشته "
"باشید که فیلتر زیر بر روی این ستون یا عبارت اعمال می‌شود."

msgid ""
"The time granularity for the visualization. Note that you can type and "
"use simple natural language as in `10 seconds`, `1 day` or `56 weeks`"
msgstr ""
"دقت زمانی برای تجسم. توجه داشته باشید که می‌توانید به زبان طبیعی ساده "
"مانند `۱۰ ثانیه`، `۱ روز` یا `۵۶ هفته` تایپ کنید و استفاده کنید."

msgid ""
"The time granularity for the visualization. Note that you can type and "
"use simple natural language as in `10 seconds`,`1 day` or `56 weeks`"
msgstr ""
"دقت زمانی برای بصری‌سازی. توجه داشته باشید که می‌توانید از زبان طبیعی "
"ساده استفاده کنید، مانند `۱۰ ثانیه`، `۱ روز` یا `۵۶ هفته`"

msgid ""
"The time granularity for the visualization. This applies a date "
"transformation to alter your time column and defines a new time "
"granularity. The options here are defined on a per database engine basis "
"in the Superset source code."
msgstr ""
"دقت زمانی برای تجسم. این یک تبدیل تاریخ را برای تغییر ستون زمان شما اعمال"
" می‌کند و یک دقت زمانی جدید تعریف می‌کند. گزینه‌های موجود در اینجا بر "
"اساس موتور پایگاه داده به صورت جداگانه در کد منبع Superset تعریف شده‌اند."

msgid ""
"The time range for the visualization. All relative times, e.g. \"Last "
"month\", \"Last 7 days\", \"now\", etc. are evaluated on the server using"
" the server's local time (sans timezone). All tooltips and placeholder "
"times are expressed in UTC (sans timezone). The timestamps are then "
"evaluated by the database using the engine's local timezone. Note one can"
" explicitly set the timezone per the ISO 8601 format if specifying either"
" the start and/or end time."
msgstr ""
"بازه زمانی برای تجسم. تمامی زمان‌های نسبی، مانند \"ماه گذشته\"، \"۷ روز "
"گذشته\"، \"هم‌اکنون\" و غیره، با استفاده از زمان محلی سرور (بدون در نظر "
"گرفتن منطقه زمانی) در سرور ارزیابی می‌شوند. تمامی نکات راهنما و زمان‌های "
"پیش‌فرض در UTC (بدون در نظر گرفتن منطقه زمانی) بیان می‌شوند. سپس، "
"زمان‌های ثبت‌شده توسط پایگاه داده با استفاده از منطقه زمانی محلی موتور "
"ارزیابی می‌شوند. توجه کنید که می‌توان به‌طور صریح منطقه زمانی را طبق فرمت"
" ISO ۸۶۰۱ مشخص کرد اگر زمان شروع و/یا پایان تعیین شود."

msgid ""
"The time unit for each block. Should be a smaller unit than "
"domain_granularity. Should be larger or equal to Time Grain"
msgstr ""
"واحد زمانی برای هر بلاک. باید کوچکتر از granularity دامنه باشد. باید "
"بزرگتر یا برابر با Grain زمان باشد."

msgid "The time unit used for the grouping of blocks"
msgstr "واحد زمانی مورد استفاده برای گروه‌بندی بلوک‌ها"

msgid ""
"The transform answered with a value the driver and the database do not "
"agree on how to write into a query, so the mirrored predicate would ask "
"for a partition key no row holds. A transform whose result carries "
"neither a quote nor a backslash still mirrors."
msgstr ""
"تبدیل مقداری برگرداند که درایور و پایگاه داده در نحوه نوشتن آن در کوئری "
"توافق ندارند، بنابراین شرط منعکس‌شده کلید پارتیشنی را می‌خواهد که هیچ "
"ردیفی ندارد. تبدیلی که نتیجه‌اش نه نقل‌قول و نه بک‌اسلش دارد همچنان منعکس"
" می‌شود."

msgid "The transform could not be evaluated against the database."
msgstr "ارزیابی تبدیل روی پایگاه داده ممکن نشد."

#, python-format
msgid "The transform could not be evaluated against the database: %(reason)s"
msgstr "ارزیابی تبدیل روی پایگاه داده ممکن نشد: %(reason)s"

#, python-format
msgid ""
"The transform could not read %(value)s written as text, which a filter "
"typed as text sends, so its answer for the timestamp can only be checked "
"by being a date or timestamp within a year of it. It answered %(typed)s, "
"so filters on this mapping will not be mirrored. Write the transform so "
"it reads :value both as a timestamp and as text."
msgstr ""
"تبدیل نتوانست %(value)s را که به‌صورت متن نوشته شده (همان‌طور که فیلتر از"
" نوع متن ارسال می‌کند) بخواند، بنابراین پاسخ آن برای برچسب زمانی فقط در "
"صورتی قابل بررسی است که تاریخ یا برچسب زمانی در فاصله یک سال از آن باشد. "
"پاسخ آن %(typed)s بود، بنابراین فیلترهای این نگاشت منعکس نمی‌شوند. تبدیل "
"را طوری بنویسید که :value را هم به‌صورت برچسب زمانی و هم به‌صورت متن "
"بخواند."

msgid "The transform does not match the stored partition keys."
msgstr "تبدیل با کلیدهای پارتیشن ذخیره‌شده مطابقت ندارد."

#, python-format
msgid ""
"The transform gives a different partition value for a timestamp "
"(%(typed)s) than for the same instant written as text (%(text)s). A time "
"range and a filter typed as text both reach it, so it cannot be right for"
" both; filters on this mapping will not be mirrored. Write the transform "
"so it reads :value the same way in either form."
msgstr ""
"تبدیل برای یک برچسب زمانی (%(typed)s) مقدار پارتیشن متفاوتی نسبت به همان "
"لحظه نوشته‌شده به‌صورت متن (%(text)s) می‌دهد. هم بازه زمانی و هم فیلتر از"
" نوع متن به آن می‌رسند، پس نمی‌تواند برای هر دو درست باشد؛ فیلترهای این "
"نگاشت منعکس نمی‌شوند. تبدیل را طوری بنویسید که :value را در هر دو شکل "
"یکسان بخواند."

msgid "The transform matched the sampled rows, not the entire dataset."
msgstr "تبدیل با ردیف‌های نمونه مطابقت داشت، نه با کل مجموعه داده."

#, python-format
msgid ""
"The transform returned %(returned)s for %(column)s, which is %(kind)s. "
"Mirrored filters on this mapping would fail at the database."
msgstr ""
"تبدیل برای %(column)s مقدار %(returned)s را برگرداند که %(kind)s است. "
"فیلترهای منعکس‌شده روی این نگاشت در پایگاه داده با خطا مواجه می‌شوند."

#, python-format
msgid ""
"The transform returned %(returned)s for %(column)s, which this database "
"cannot write into a query as a %(type)s value without changing it. "
"Filters on this mapping will not be mirrored."
msgstr ""
"تبدیل برای %(column)s مقدار %(returned)s را برگرداند که این پایگاه داده "
"نمی‌تواند بدون تغییر آن را به‌عنوان مقدار %(type)s در کوئری بنویسد. "
"فیلترهای این نگاشت منعکس نمی‌شوند."

msgid "The two passwords that you entered do not match!"
msgstr "دو گذرواژه‌ای که وارد کردید یکسان نیستند!"

msgid "The type of the layer"
msgstr "نوع لایه"

msgid "The type of visualization to display"
msgstr "نوع تجسم برای نمایش"

msgid "The unit for icon size"
msgstr "واحد اندازه نماد"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: cs, de, ja,
# lv, ru, sk, sr, sr_Latn, tr, uk]
msgid "The unit for label size"
msgstr "واحد اندازه برچسب"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ja]
msgid ""
"The unit for point radius. Use \"pixels\" for consistent screen-space "
"sizing regardless of zoom level."
msgstr ""
"واحد شعاع نقطه. برای اندازه ثابت روی صفحه صرف‌نظر از سطح بزرگ‌نمایی، از "
"«پیکسل» استفاده کنید."

msgid "The unit of measure for the specified point radius"
msgstr "واحد اندازه‌گیری برای شعاع نقطه مشخص شده"

msgid "The upper limit of the threshold range of the Isoband"
msgstr "حد بالایی دامنه آستانه ایزوبند"

msgid "The user has been created successfully."
msgstr "کاربر با موفقیت ایجاد شد."

msgid "The user has been updated successfully."
msgstr "کاربر با موفقیت به‌روزرسانی شد."

#, python-format
msgid ""
"The user this report runs as cannot access this %(kind)s. Choose a "
"%(kind)s that user can access, or ask an admin to change who the report "
"runs as."
msgstr ""
"کاربری که گزارش با او اجرا می‌شود به این %(kind)s دسترسی ندارد. یک "
"%(kind)s انتخاب کنید که آن کاربر به آن دسترسی دارد، یا از مدیر سیستم "
"بخواهید کاربر اجراکننده گزارش را تغییر دهد."

msgid "The user was updated successfully"
msgstr "کاربر با موفقیت به‌روزرسانی شد"

msgid ""
"The user whose database credentials are used to run the alert condition "
"query. Defaults to the \"Run as\" user."
msgstr ""
"کاربری که اعتبارنامه پایگاه داده او برای اجرای کوئری شرط هشدار استفاده "
"می‌شود. پیش‌فرض، کاربر «اجرا به‌عنوان» است."

#, python-format
msgid ""
"The user whose permissions and database credentials are used to render "
"this %s. Application default uses ALERT_REPORTS_EXECUTORS. Only admins "
"can pick another user."
msgstr ""
"کاربری که مجوزها و اعتبارنامه پایگاه داده او برای ساخت این %s استفاده "
"می‌شود. پیش‌فرض برنامه از ALERT_REPORTS_EXECUTORS استفاده می‌کند. فقط "
"مدیران می‌توانند کاربر دیگری انتخاب کنند."

msgid "The user/password combination is not valid (Incorrect password for user)."
msgstr "ترکیب نام کاربری/رمز عبور معتبر نیست (رمز عبور نادرست برای کاربر)."

#, python-format
msgid "The username \"%(username)s\" does not exist."
msgstr "نام کاربری \"%(username)s\" وجود ندارد."

msgid "The username provided when connecting to a database is not valid."
msgstr "نام کاربری ارائه شده در زمان اتصال به پایگاه داده نامعتبر است."

#, python-format
msgid ""
"The value transform calls %(functions)s, whose result depends on when and"
" where it runs. The transform is evaluated in a separate session and the "
"result is cached, so the emitted predicate would freeze a snapshot of "
"that moment."
msgstr ""
"تبدیل مقدار، %(functions)s را فراخوانی می‌کند که نتیجه‌اش به زمان و مکان "
"اجرا بستگی دارد. تبدیل در یک نشست جداگانه ارزیابی و نتیجه آن کش می‌شود، "
"بنابراین شرط تولیدشده تصویری از همان لحظه را ثابت نگه می‌دارد."

msgid ""
"The value transform could not be parsed. The mapping is saved but stays "
"inactive until it does."
msgstr ""
"تبدیل مقدار قابل تجزیه نیست. نگاشت ذخیره شده اما تا زمانی که تجزیه شود "
"غیرفعال می‌ماند."

#, python-format
msgid ""
"The value transform could not be parsed: %(detail)s The mapping is saved "
"but stays inactive until it does."
msgstr ""
"تبدیل مقدار قابل تجزیه نیست: %(detail)s نگاشت ذخیره شده اما تا زمانی که "
"تجزیه شود غیرفعال می‌ماند."

msgid ""
"The value transform must contain the :value placeholder, which stands for"
" the filter value being mirrored."
msgstr ""
"تبدیل مقدار باید شامل جای‌نگهدار :value باشد که نماینده مقدار فیلتری است "
"که منعکس می‌شود."

#, python-format
msgid "The value transform on %(column)s cannot be saved: %(reason)s"
msgstr "تبدیل مقدار روی %(column)s قابل ذخیره نیست: %(reason)s"

#, python-format
msgid ""
"The value transform on %(mapped)s is not mirroring filters, so queries "
"will scan every partition."
msgstr ""
"تبدیل مقدار روی %(mapped)s فیلترها را منعکس نمی‌کند، بنابراین کوئری‌ها "
"همه پارتیشن‌ها را پیمایش می‌کنند."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: cs, de, fr,
# ja, lv, ro, ru, sk, sr, sr_Latn, tr, uk]
msgid "The values overlap other breakpoint values"
msgstr "مقادیر با مقادیر نقاط شکست دیگر هم‌پوشانی دارند"

msgid "The version of the service"
msgstr "نسخه سرویس"

msgid "The view configuration must be a JSON object."
msgstr "پیکربندی نما باید یک شیء JSON باشد."

msgid "The visible title of the layer"
msgstr "عنوان قابل مشاهده لایه"

msgid "The way the ticks are laid out on the X-axis"
msgstr "شیوه چیدمان تیک‌ها بر روی محور X"

msgid "The width of the Isoline in pixels"
msgstr "عرض ایزولین به پیکسل"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ca, cs, de,
# es, fr, ja, lv, mi, ro, ru, sk, sr, sr_Latn, tr, uk]
msgid "The width of the current zoom level to compute all widths from"
msgstr "عرض سطح بزرگ‌نمایی فعلی که همه عرض‌ها بر اساس آن محاسبه می‌شوند"

msgid "The width of the elements border"
msgstr "ضخامت حاشیه عناصر"

msgid "The width of the lines"
msgstr "عرض خطوط"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: de, sr,
# sr_Latn]
msgid ""
"The width of the lines as either a fixed value or variable width based on"
" a metric."
msgstr "عرض خطوط، به‌صورت مقدار ثابت یا عرض متغیر بر اساس یک معیار."

msgid "Theme"
msgstr "پوسته"

msgid "Theme colors"
msgstr "رنگ‌های پوسته"

msgid "Theme could not be created."
msgstr "پوسته ایجاد نشد."

msgid "Theme could not be updated."
msgstr "پوسته به‌روزرسانی نشد."

msgid "Theme imported"
msgstr "پوسته وارد شد"

msgid "Theme not found."
msgstr "پوسته پیدا نشد."

msgid "Theme parameters are invalid."
msgstr "پارامترهای پوسته نامعتبر هستند."

msgid "Themes"
msgstr "پوسته‌ها"

msgid "Themes could not be deleted."
msgstr "پوسته‌ها حذف نشدند."

msgid "There are associated alerts or reports"
msgstr "هشدارها یا گزارش‌های مربوطه وجود دارند"

#, python-format
msgid "There are associated alerts or reports: %(report_names)s"
msgstr "هشدارها یا گزارش‌های مرتبط وجود دارد: %(report_names)s"

msgid "There are no charts added to this dashboard"
msgstr "هیچ نموداری به این داشبورد اضافه نشده است"

msgid "There are no components added to this tab"
msgstr "هیچ مؤلفه‌ای به این تب اضافه نشده است"

msgid "There are no filters in this dashboard."
msgstr "در این داشبورد هیچ فیلتری وجود ندارد."

msgid "There are unsaved changes."
msgstr "تغییرات ذخیره‌نشده‌ای وجود دارد."

msgid ""
"There is a syntax error in the SQL query. Perhaps there was a misspelling"
" or a typo."
msgstr ""
"یک خطای نحوی در کوئریی SQL وجود دارد. شاید یک اشتباه املایی یا تایپی رخ "
"داده باشد."

msgid "There is currently no information to display."
msgstr "در حال حاضر اطلاعاتی برای نمایش وجود ندارد."

msgid ""
"There is no chart definition associated with this component, could it "
"have been deleted?"
msgstr ""
"هیچ تعریفی برای نمودار مرتبط با این مؤلفه وجود ندارد، آیا ممکن است که حذف"
" شده باشد؟"

msgid ""
"There is not enough space for this component. Try decreasing its width, "
"or increasing the destination width."
msgstr ""
"برای این قسمت فضای کافی وجود ندارد. سعی کنید عرض آن را کاهش دهید یا عرض "
"مقصد را افزایش دهید."

