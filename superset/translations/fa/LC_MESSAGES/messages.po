"/api/v1/dataset/%(uuid)s/restore بازیابی کنید یا نام جدول دیگری به کار "
"ببرید."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ja]
#, python-format
msgid ""
"A soft-deleted dataset (uuid %(uuid)s) already references this table. "
