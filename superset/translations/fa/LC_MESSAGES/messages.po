msgid "Viewers cannot be added while the ENABLE_VIEWERS feature flag is disabled"
msgstr ""
"تا زمانی که پرچم قابلیت ENABLE_VIEWERS غیرفعال است، نمی‌توان بیننده اضافه"
" کرد"

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: ca, cs, de,
