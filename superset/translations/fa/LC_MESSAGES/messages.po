msgstr "این پیوند قابل باز شدن نیست، زیرا نشانی آن ناامن است."

#, python-format
msgid "This link expires in %(duration)s (%(when)s UTC)."
msgstr "این پیوند در %(duration)s (%(when)s به وقت UTC) منقضی می‌شود."

# Machine-translated via backfill_po.py (claude-sonnet-4-6) [refs: de, sr,
# sr_Latn]
msgid ""
"This link will take you to an external website. We cannot guarantee the "
